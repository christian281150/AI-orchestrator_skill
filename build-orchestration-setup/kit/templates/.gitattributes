# Fix line endings BEFORE anything is hashed or pinned. A file hashed under one
# line-ending setting and checked under another fails its checksum for no reason.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary
*.docx binary
*.pptx binary
