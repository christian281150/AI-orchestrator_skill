{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(git status:*)", "Bash(git log:*)", "Bash(git diff:*)", "Bash(git branch:*)", "Bash(git worktree:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git merge:*)", "Bash(git checkout:*)", "Bash(git switch:*)",
      "Bash(git rev-parse:*)", "Bash(git show:*)", "Bash(git grep:*)",
      "Bash(python tools/orch.py:*)", "Bash(python3 tools/orch.py:*)",
      "Bash(npm test:*)", "Bash(npm run:*)", "Bash(npx tsc:*)", "Bash(pytest:*)", "Bash(python -m pytest:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)", "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)", "Read(.env)", "Read(.env.*)", "Read(secrets/**)"
    ]
  }
}
