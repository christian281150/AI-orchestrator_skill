#!/bin/sh
# Forbidden paths, secrets in added lines, board consistency, author. See tools/orchestrator/hooks.py
ROOT="$(git rev-parse --show-toplevel)"
PY=""
for c in python3 python py; do   # first interpreter that really is Python 3.11+ (skips the Windows Store stub)
  if "$c" -c "import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)" >/dev/null 2>&1; then PY="$c"; break; fi
done
[ -n "$PY" ] || { echo "git hook: Python 3.11+ not found on PATH" >&2; exit 1; }
exec "$PY" "$ROOT/tools/orch.py" --config "$ROOT/orchestration.toml" hook pre-commit
